root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[**/debian/rules]
indent_style = tab

[{*.gpg,RPM-GPG-KEY-*}]
insert_final_newline = false
trim_trailing_whitespace = false
