debhelper-build-stamp
.debhelper
*.deb
*.dsc
*.build
*.buildinfo
*.changes
*.tar.gz
*.tar.xz
*.log
*.substvars

# agent specific
# NOTE: etc/ocsinventory-agent/config.json is tracked on purpose (static
# default config, not fetched) - only usr/share/ (the prebuilt ocsinventory-cli
# + scripts, fetched from the agent's own release at build time) is ignored.
ocsinventory-agent/deb/ocsinventory-agent/debian/ocsinventory-agent
ocsinventory-agent/deb/ocsinventory-agent/usr
ocsinventory-agent/deb/ocsinventory-agent/debian/files

# snmp-scanner specific: usr/share/ is filled from the upstream tarball and
# etc/ is generated by debian/rules; only the .gitkeep placeholder is tracked.
ocsinventory-snmp-scanner/deb/ocsinventory-snmp-scanner/debian/ocsinventory-snmp-scanner
ocsinventory-snmp-scanner/deb/ocsinventory-snmp-scanner/debian/files
ocsinventory-snmp-scanner/deb/ocsinventory-snmp-scanner/etc
ocsinventory-snmp-scanner/deb/ocsinventory-snmp-scanner/usr/share/ocsinventory-snmp-scanner/*
!ocsinventory-snmp-scanner/deb/ocsinventory-snmp-scanner/usr/share/ocsinventory-snmp-scanner/.gitkeep
