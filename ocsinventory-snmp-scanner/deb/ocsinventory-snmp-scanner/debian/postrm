#!/bin/sh
set -e

PKG=ocsinventory-snmp-scanner

case "$1" in
    remove)
        # Generated by postinst, so dpkg does not track it.
        rm -rf /usr/lib/$PKG
        ;;
    purge)
        rm -rf /usr/lib/$PKG /var/log/$PKG /var/lib/$PKG
        if getent passwd ocssnmp >/dev/null; then
            deluser --system ocssnmp >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
